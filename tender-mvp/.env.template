# Construction Tender MVP – Environment Variables
# Copy this file to .env and fill in values. Never commit .env to version control.

# ---- Parser Adapter ----
# Set to "true" to use the built-in mock fixture (no external API calls)
# Set to "false" to use the live Azure Document Intelligence wrapper service
PARSER_USE_MOCK=true

# Base URL of the Azure Document Intelligence wrapper API
# Required when PARSER_USE_MOCK=false
PARSER_API_URL=https://your-parser-api.example.com

# API key for the parser service. Keep this secret.
PARSER_API_KEY=your-api-key-here

# ---- App Server ----
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Future integrations (not required for MVP) ----
# Azure OpenAI endpoint and key (for LLM disambiguation – optional)
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ---- Tenant ----
# Fixed demo tenant for this MVP
DEMO_TENANT_ID=demo-internal
