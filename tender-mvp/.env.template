# Azure Document Intelligence
AZURE_DOC_INTEL_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOC_INTEL_KEY=<your-key>

# OpenAI / Azure OpenAI
OPENAI_API_KEY=<your-openai-key>
# Optional: if using Azure OpenAI, set these instead
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_KEY=<your-key>
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Demo tenant (fixed for MVP; real tenants come later)
DEMO_TENANT_ID=demo-tenant-001

# Set to "true" to use mock parser fixture instead of real Azure API
MOCK_PARSER=true

# SQLite database path (relative to backend/)
DATABASE_URL=sqlite:///./tender_mvp.db

# Master data version to load on startup
MASTER_DATA_VERSION=v1

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000

# Required when APP_ENV=uat. Protects the UI and legacy API routes with HTTP Basic auth.
# UAT_ACCESS_USERNAME=uat
# UAT_ACCESS_PASSWORD=<operator-entered-secret>
